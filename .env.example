# Optional AI service configuration. Manual organization needs no AI service.
# Copy to .env and fill your own values. Never upload .env or your API key.
# Basic simulation currently supports DashScope Beijing qwen3.8-max only.
AETHERLOOM_PROVIDER=openai-compatible

# API root provided by the vendor (include /v1 if the vendor requires it).
AETHERLOOM_API_BASE_URL=

# Keep the secret only in local .env.
AETHERLOOM_API_KEY=

# Exact model ID. Basic simulation requires qwen3.8-max.
AETHERLOOM_CREATOR_MODEL=

# Request timeout in seconds. Explicit extraction/retry actions may incur provider charges.
AETHERLOOM_REQUEST_TIMEOUT_SECONDS=120
